% Clear vars
clc;
clear;

% Compile lists of filepaths
goodTrainFiles = { ... 
    "./images/good1.jpg", ...
    "./images/good2.jpg", ...
    "./images/good3.jpg" };

goodTestFiles = { ...
    "./images/good4.jpg", ...
    "./images/good5.jpg", };

badTrainFiles = { ... 
    "./images/bruised1.jpg", ...
    "./images/bruised2.jpg", ...
    "./images/bruised3.jpg" };

badTestFiles = { ...
    "./images/bruised4.jpg", ...
    "./images/bruised5.jpg", };

% Compile taining files
trainFiles = [goodTrainFiles, badTrainFiles];

% Define the training and sample numbers
nTrain = 6;
nFeatures = 2;

% Declare the X training set
X = zeros(nTrain, nFeatures);

% Process training images
for i = 1:nTrain
    % Get the filename
    filename = trainFiles{i};

    % Load the image
    bananaImage = imread(filename);

    % Get the banana masks from the Thresholder App
    [BW_banana, maskedRGB] = createBananaMask(bananaImage);

    % Clean the mask
    BW_banana = cleanMask(BW_banana);

    % Detect the bounding box
    bbox = getbbox(BW_banana);

    % Crop the image
    [croppedImage, croppedMask] = cropBanana(bananaImage, BW_banana, bbox);

    % Get the good and bad pixel masks
    [goodMask, badMask] = getMasks(croppedImage, croppedMask);

    % Get pixel counts
    [N_good, N_bad] = getPixels(goodMask, badMask);

    % Append good and bad pixel counts to X
    X(i, :) = [N_good, N_bad];

end

% Compile testing files
testFiles = [goodTestFiles, badTestFiles];

% Define the testing numbers
nTest = 4;

% Declare the x training set
Xtest = zeros(nTest, nFeatures);

% Process testing images
for i = 1:nTest
    % Get the filename
    filename = testFiles{i};

    % Load the image
    bananaImage = imread(filename);

    % Get the banana masks from the Thresholder App
    [BW_banana, maskedRGB] = createBananaMask(bananaImage);

    % Clean the mask
    BW_banana = cleanMask(BW_banana);

    % Detect the bounding box
    bbox = getbbox(BW_banana);

    % Crop the image
    [croppedImage, croppedMask] = cropBanana(bananaImage, BW_banana, bbox);

    % Get the good and bad pixel masks
    [goodMask, badMask] = getMasks(croppedImage, croppedMask);

    % Get pixel counts
    [N_good, N_bad] = getPixels(goodMask, badMask);

    % Append good and bad pixel counts to X
    Xtest(i, :) = [N_good, N_bad];

end

% Label training set
% 0 = good
% 1 = bruised
yTrain = [zeros(numel(goodTrainFiles), 1); ones(numel(badTrainFiles), 1)];

% Label test set
yTest = [zeros(numel(goodTestFiles), 1); ones(numel(badTestFiles), 1)];

% Declare number of nearest neighbors
k = 3;

% Perform a knnsearch between X and Y to find indices of nearest neighbors
Idx = knnsearch(X, Xtest, 'K', k);

% Get the labels of the knn results
neighborLabels = yTrain(Idx);

% Find the majority of labels (prediction)
yPred = mode(neighborLabels, 2);

% Make the decision
decisionStr = strings(nTest, 1);
for i = 1:nTest
    if yPred(i) == 0
        decisionStr(i) = "OK";
    else
        decisionStr(i) = "bruised";
    end

    fprintf('%s \t-> predicted: %s | neighbor labels = %s\n', ... 
        testFiles{i}, decisionStr(i), mat2str(neighborLabels(i,:)));
end

fprintf('Training');
% Print training accuracy
printAccuracy(yPred, yTest, nTest)

% Compute training accuracy
% Find k + 1 neighbors (first neighbor will be itself)
IdxTrain = knnsearch(X, X, 'K', k + 1);

% Drop the first neighbor (itself)
IdxTrain = IdxTrain(:, 2:end);

% Get labels of KNN results
neighborLabelsTrain = yTrain(IdxTrain);

% Find the majority of labels
yPredTrain = mode(neighborLabelsTrain, 2);

fprintf('Testing\n');
% Print training accuracy
printAccuracy(yPredTrain, yTrain, nTrain)


% === FUNCTIONS ===

function [BW,maskedRGBImage] = createBananaMask(RGB)
%createBananaMask  Threshold RGB image using auto-generated code from colorThresholder app.
%  [BW,MASKEDRGBIMAGE] = createBananaMask(RGB) thresholds image RGB using
%  auto-generated code from the colorThresholder app. The colorspace and
%  range for each channel of the colorspace were set within the app. The
%  segmentation mask is returned in BW, and a composite of the mask and
%  original RGB images is returned in maskedRGBImage.

% Auto-generated by colorThresholder app on 28-Nov-2025
%------------------------------------------------------


% Convert RGB image to chosen color space
I = rgb2hsv(RGB);

% Define thresholds for channel 1 based on histogram settings
channel1Min = 0.000;
channel1Max = 1.000;

% Define thresholds for channel 2 based on histogram settings
channel2Min = 0.487;
channel2Max = 1.000;

% Define thresholds for channel 3 based on histogram settings
channel3Min = 0.000;
channel3Max = 1.000;

% Create mask based on chosen histogram thresholds
sliderBW = (I(:,:,1) >= channel1Min ) & (I(:,:,1) <= channel1Max) & ...
    (I(:,:,2) >= channel2Min ) & (I(:,:,2) <= channel2Max) & ...
    (I(:,:,3) >= channel3Min ) & (I(:,:,3) <= channel3Max);
BW = sliderBW;

% Initialize output masked image based on input image.
maskedRGBImage = RGB;

% Set background pixels where BW is false to zero.
maskedRGBImage(repmat(~BW,[1 1 3])) = 0;

end


function [BW,maskedRGBImage] = createBadMask(RGB)
%createMask  Threshold RGB image using auto-generated code from colorThresholder app.
%  [BW,MASKEDRGBIMAGE] = createMask(RGB) thresholds image RGB using
%  auto-generated code from the colorThresholder app. The colorspace and
%  range for each channel of the colorspace were set within the app. The
%  segmentation mask is returned in BW, and a composite of the mask and
%  original RGB images is returned in maskedRGBImage.

% Auto-generated by colorThresholder app on 02-Dec-2025
%------------------------------------------------------


% Convert RGB image to chosen color space
I = RGB;

% Define thresholds for channel 1 based on histogram settings
channel1Min = 50.000;
channel1Max = 123.000;

% Define thresholds for channel 2 based on histogram settings
channel2Min = 25.000;
channel2Max = 100.000;

% Define thresholds for channel 3 based on histogram settings
channel3Min = 0.000;
channel3Max = 255.000;

% Create mask based on chosen histogram thresholds
sliderBW = (I(:,:,1) >= channel1Min ) & (I(:,:,1) <= channel1Max) & ...
    (I(:,:,2) >= channel2Min ) & (I(:,:,2) <= channel2Max) & ...
    (I(:,:,3) >= channel3Min ) & (I(:,:,3) <= channel3Max);
BW = sliderBW;

% Initialize output masked image based on input image.
maskedRGBImage = RGB;

% Set background pixels where BW is false to zero.
maskedRGBImage(repmat(~BW,[1 1 3])) = 0;

end


function [bananaMask] = cleanMask(bananaMask)

% Remove small objects from mask
bananaMask = bwareaopen(bananaMask, 500);

% Fill holes in image
bananaMask = imfill(bananaMask, 'holes');

% Keep only the largest region (the banana)
bananaMask = bwareafilt(bananaMask, 1);

end


function [bbox] = getbbox(bananaMask)

% Detect the bounding box of the banana
props = regionprops(bananaMask, 'BoundingBox');
bbox = props(1).BoundingBox;

end


function [croppedRGB, croppedMask] = cropBanana(bananaImage, BW_banana, bbox)

% Crop the the RGB and mask images
croppedRGB = imcrop(bananaImage, bbox);
croppedMask = imcrop(BW_banana, bbox);

end


function [goodMask, bruiseMask] = getMasks(bananaImage, croppedMask)

% Create a bruise mask out of non-good pixels
bruiseMask = createBadMask(bananaImage);

% Detect "good" yellow pixels
goodMask = croppedMask & not(bruiseMask);

figure();
subplot(1,3,1), imshow(bananaImage); title('RGB');
subplot(1,3,2), imshow(bruiseMask); title('Buise mask');
subplot(1,3,3), imshow(goodMask); title('Good mask');

end


function [good_pxls, bad_pxls] = getPixels(goodMask, bruiseMask)

% Find the counts of yellow pixels and bruise pixels
good_pxls = nnz(goodMask);
bad_pxls = nnz(bruiseMask);

end

function printAccuracy(yPred, yTest, nTest)

% Compute accuracies
numCorrectTest = sum(yPred == yTest);
testAccuracy = numCorrectTest / nTest * 100;
fprintf('\nAccuracy: %d / %d = %.2f%%%\n', numCorrectTest, nTest, testAccuracy);

end